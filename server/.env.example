# Copy to server/.env and fill in. Never commit the real file.

# Dev token from the Root Developer Portal (local testing with the dev host).
DEV_TOKEN=

# Auth token from the Root Developer Portal (used by `npm run upload`).
AUTH_TOKEN=

# Optional: move the dev host off its default ports (8080-8082) if they're taken.
# ROOT_DEV_WS_PORT=8180
# ROOT_DEV_WS_UPDATE_PORT=8182
